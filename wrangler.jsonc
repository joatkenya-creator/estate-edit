{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estate-edit",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Capture runtime logs/errors (e.g. 1102 "exceeded resource limits") in the
  // dashboard so render-cost issues are diagnosable instead of invisible.
  "observability": { "enabled": true },
  // Keep the *.workers.dev URL alive alongside the custom domain (adding custom
  // routes disables it by default, which would 404 the old URL during cutover).
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "estate-edit"
    }
  ],

  // --- Abuse-prevention rate limiting (KV-backed) ---------------------------
  // Used by src/lib/rate-limit.ts to throttle the M-Pesa STK-push endpoint
  // (per-user + per-target-phone) and checkout order placement (per-IP).
  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV", "id": "6127260ea1174713be78b441ac8edd1e" }
  ],

  // --- Order notifications via Cloudflare Email Routing -------------------
  // Lets the Worker send the new-order alert to a VERIFIED destination address.
  // Before this works: enable Email Routing on estateedit.org and verify this
  // address as a destination (Cloudflare emails it a confirmation link).
  "send_email": [
    { "name": "ORDER_EMAIL", "destination_address": "joatkenya120@gmail.com" }
  ],

  // --- Custom domain -------------------------------------------------------
  // Serves the Worker at estateedit.org (+ www), registered via Cloudflare
  // Registrar so the zone is already active on this account. On `npm run
  // deploy` Wrangler provisions these custom domains and their proxied DNS
  // records automatically; Cloudflare issues the SSL cert.
  "routes": [
    { "pattern": "estateedit.org", "custom_domain": true },
    { "pattern": "www.estateedit.org", "custom_domain": true },
    // Virginia (USD) storefront — same Worker, region resolved from this host.
    { "pattern": "us.estateedit.org", "custom_domain": true }
  ]

  // --- Optional: persistent ISR / Next cache via R2 ------------------------
  // Your pages use `revalidate = 600`. Without a cache binding, revalidation
  // still works but isn't shared across Worker instances. To enable it:
  //   1) wrangler r2 bucket create estate-edit-cache
  //   2) uncomment the block below
  //   3) in open-next.config.ts, set incrementalCache: r2IncrementalCache
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "estate-edit-cache" }
  // ]
}
